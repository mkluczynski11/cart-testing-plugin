{
  "name": "qa-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "The qa harness and library for scenario-driven cart tests (design v0.3).",
  "bin": {
    "qa-harness": "support/harness/cli.ts"
  },
  "scripts": {
    "test:unit": "playwright test --project unit",
    "qa": "tsx support/harness/cli.ts",
    "qa:toolshop": "tsx support/harness/cli.ts --root ../../examples/toolshop",
    "typecheck:toolshop": "tsc --noEmit -p ../../examples/toolshop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
