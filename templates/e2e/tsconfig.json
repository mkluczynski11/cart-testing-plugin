{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["support/**/*.ts", "app/**/*.ts", "unit/**/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
