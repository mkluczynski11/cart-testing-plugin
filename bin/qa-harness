#!/usr/bin/env node
// qa-harness on the Bash tool's PATH: finds the tester's e2e root and runs the harness installed there.
// Implements design 6.1 (same behaviour from the repo root and from e2e/) and order D notes 8-11 (init, doctor before setup).
import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as path from 'node:path';
import { fileURLToPath } from 'node:url';

const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const args = process.argv.slice(2);

/** An e2e root holds qa.config.json and the harness entry point. */
const isRoot = (dir) =>
  fs.existsSync(path.join(dir, 'qa.config.json')) && fs.existsSync(path.join(dir, 'support', 'harness', 'cli.ts'));

/** ./e2e, the current directory, or the nearest parent that is (or holds) an e2e root. */
function findRoot(start) {
  for (let dir = path.resolve(start); ; dir = path.dirname(dir)) {
    if (isRoot(dir)) return dir;
    if (isRoot(path.join(dir, 'e2e'))) return path.join(dir, 'e2e');
    if (path.dirname(dir) === dir) return undefined;
  }
}

function finish(lines, verdict) {
  for (const l of lines) console.log(l);
  console.log(`VERDICT: ${verdict}`);
  process.exit(verdict === 'PASS' ? 0 : 1);
}

/** doctor before setup: Node, git and the network, then the one sentence that setup has not run. */
async function doctorBeforeSetup() {
  const lines = [];
  let ok = true;
  const major = Number(process.versions.node.split('.')[0]);
  if (major >= 20) lines.push(`ok: Node ${process.versions.node}`);
  else { ok = false; lines.push(`fail: Node ${process.versions.node} is older than 20; install Node 20 or newer.`); }
  const git = spawnSync('git', ['--version'], { encoding: 'utf8' });
  if (git.status === 0) lines.push(`ok: ${git.stdout.trim()}`);
  else { ok = false; lines.push('fail: git is not installed or not on PATH; install git.'); }
  try {
    const res = await fetch('https://registry.npmjs.org/@playwright%2ftest', { method: 'HEAD', signal: AbortSignal.timeout(5000) });
    if (res.ok) lines.push('ok: the npm registry answers');
    else { ok = false; lines.push(`fail: the npm registry answered ${res.status}; setup needs it to install Playwright.`); }
  } catch (e) {
    ok = false;
    lines.push(`fail: the npm registry did not answer (${e.cause?.code ?? e.name}); setup needs the network to install Playwright.`);
  }
  lines.push('No e2e/ directory here or in a parent: setup has not run; run /qa:setup <app> <base-url> first.');
  finish(lines, ok ? 'PASS' : 'INFRA_FAIL');
}

const command = args[0];
if (command === 'init') {
  const r = spawnSync(process.execPath, [path.join(pluginRoot, 'scripts', 'init.mjs'), ...args.slice(1)], { stdio: 'inherit' });
  process.exit(r.status ?? 1);
}

const root = findRoot(process.cwd());
if (!root) {
  if (command === 'doctor') await doctorBeforeSetup();
  else finish([`No e2e/ directory here or in a parent: setup has not run, so "${command ?? ''}" has nothing to work on; run /qa:setup <app> <base-url> first.`], 'INFRA_FAIL');
}

const tsx = path.join(root, 'node_modules', '.bin', process.platform === 'win32' ? 'tsx.cmd' : 'tsx');
if (!fs.existsSync(tsx)) {
  finish([`${path.relative(process.cwd(), root) || '.'} has no installed dependencies; run "npm ci" there or /qa:setup again.`], 'INFRA_FAIL');
}
const r = spawnSync(tsx, [path.join('support', 'harness', 'cli.ts'), ...args], { cwd: root, stdio: 'inherit' });
process.exit(r.status ?? 1);
